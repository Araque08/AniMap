NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=TU_CONTRASEÑA_AQUI
DB_NAME=animap
DB_SSL=false

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=animap

JWT_ACCESS_SECRET=GENERA_UN_SECRET_SEGURO
JWT_REFRESH_SECRET=GENERA_OTRO_SECRET_SEGURO
ACCESS_TOKEN_TTL= 30m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=*

# WARN permite pruebas fuera de la zona conservando inside=false.
# ENFORCE bloquea escrituras fuera. Ausente/inválido usa ENFORCE (fail-safe).
GEOFENCE_MODE=WARN

# Clave exclusiva del backend para Google Maps Platform - Geocoding API.
GOOGLE_GEOCODING_API_KEY=

# Envíos push: habilitar solo tras aplicar la migración y autorizar la prueba.
# Usa ADC del servidor y exclusivamente el proyecto Firebase animapbd.
FCM_PUSH_ENABLED=false
# inline: temporizador local. scheduled: solo la ruta OIDC, para Cloud Run.
FCM_PROCESSING_MODE=inline
NOTIFICATION_WORKER_AUDIENCE=
NOTIFICATION_WORKER_SERVICE_ACCOUNT_EMAIL=
# En Cloud Run usar 1; local conserva 0. Pool por instancia, no por usuario.
TRUST_PROXY_HOPS=0
DB_POOL_MAX=5

# Aislamiento QA: exige ambos IDs positivos. Incompleto/invalido bloquea el procesador.
# No habilita envios por si solo; FCM_PUSH_ENABLED sigue siendo el interruptor general.
FCM_TEST_MODE=false
FCM_TEST_OWNER_ID=
FCM_TEST_REPORT_ID=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=animapoficial@gmail.com
MAIL_PASS=TU_CONTRASEÑA_DE_APLICACIÓN_DE_GMAIL
MAIL_FROM=AniMap <animapoficial@gmail.com>
